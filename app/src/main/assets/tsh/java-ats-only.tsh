/* Java TSH isolation profile: TREE-SITTER ATS ONLY. Only AST selectors and native SCM queries are enabled. */
{
    language {
        id: "java"
        name: "Java"
        extensions: [".java", ".jav"]
        aliases: ["Java"]
        mimeTypes: ["text/x-java-source", "text/x-java"]
    }
    name: ["Java", ".java", ".jav"],
    ignoreCase: false,

    // =========================================================================
    // 1. Editor language metadata
    // =========================================================================
    editor {
        tabSize: 4
        fontSize: 14
        insertSpaces: true
        autoIndent: true
        trimTrailingWhitespace: true
        formatOnType: false
        renderWhitespace: "selection"
        lineNumbers: true
        comments {
            line: ["//"]
            block: [["/*", "*/"]]
        }
        brackets: ["{}", "[]", "()", "<>"]
        bracketNotIn: ["string", "comment"]
        autoClosingPairs: [
            { open: "(", close: ")", notIn: ["string", "comment"] }
            { open: "[", close: "]", notIn: ["string", "comment"] }
            { open: "{", close: "}", notIn: ["string", "comment"] }
            { open: "\"", close: "\"", notIn: ["string", "comment"] }
        ]
        surroundingPairs: ["{}", "[]", "()", "\"\""]
        completion {
            triggerCharacters: [".", "@", ":"]
        }
        electricCharacters: ["}", ";"]
        }

    // =========================================================================
    // 2. Shared semantic styles and color schemes
    // Keep this catalog identical to Regex-only and Hybrid profiles.
    // =========================================================================
    isDark: false,
    defaultScheme: "darcula",
    styles {
        keyword       { scope: "keyword.control", tags: ["keyword", "control"] }
        keyword2      { scope: "keyword.context", tags: ["keyword", "contextual"] }
        type          { scope: "entity.name.type", tags: ["type", "declaration"] }
        typeBuiltin   { scope: "support.type", tags: ["type", "builtin"] }
        string        { scope: "string.quoted", tags: ["string"] }
        stringBlock   { scope: "string.quoted.block", tags: ["string", "multiline"] }
        comment       { scope: "comment", tags: ["comment"] }
        docComment    { scope: "comment.block.documentation", tags: ["comment", "documentation"] }
        docTag        { scope: "keyword.other.documentation", tags: ["documentation", "tag"] }
        number        { scope: "constant.numeric", tags: ["constant", "number"] }
        annotation    { scope: "storage.type.annotation", tags: ["annotation", "metadata"] }
        constant      { scope: "constant.language", tags: ["constant"] }
        variable      { scope: "variable.other", tags: ["variable"] }
        function      { scope: "entity.name.function", tags: ["function"] }
        operator      { scope: "keyword.operator", tags: ["operator"] }
    },
    schemes {
        darcula {
            light [
                keyword: #0000FF @bold,
                keyword2: #7F0055,
                type: #2B91AF,
                typeBuiltin: #0000FF,
                string: #A31515,
                stringBlock: #800000,
                comment: #008000,
                docComment: #3F5FBF @no-bold,
                docTag: #7F0055 @bold,
                number: #098658,
                annotation: #2B91AF,
                constant: #6F42C1 @bold,
                variable: #001080,
                function: #795E26,
                operator: #000000
            ]
            dark [
                keyword: #CC7832 @bold,
                keyword2: #6897BB,
                type: #4EC9B0,
                typeBuiltin: #E06C75,
                string: #6A8759,
                stringBlock: #497B51,
                comment: #808080,
                docComment: #629755 @no-bold,
                docTag: #C69D48 @bold,
                number: #6897BB,
                annotation: #BBB529,
                constant: #9876AA @bold,
                variable: #A9B7C6,
                function: #FFC66D,
                operator: #A9B7C6
            ]
            ui {
                light {
                    editor.background: #FFFFFF
                    editor.foreground: #202020
                    editor.selection: #ADD6FF
                    editor.lineHighlight: #F2F2F2
                    editor.gutter: #858585
                    editor.caret: #000000
                    activity.background: #FFFFFF
                    activity.surface: #F4F4F4
                    activity.toolbar.background: #F4F4F4
                    activity.toolbar.foreground: #202020
                    activity.tabs.background: #F4F4F4
                    activity.tabs.foreground: #666666
                    activity.tabs.selected: #202020
                    activity.tabs.indicator: #3F51B5
                    activity.statusBar: #EAEAEA
                    activity.navigationBar: #FFFFFF
                }
                dark {
                    editor.background: #2B2B2B
                    editor.foreground: #A9B7C6
                    editor.selection: #214283
                    editor.lineHighlight: #323232
                    editor.gutter: #6B6B6B
                    editor.caret: #FFFFFF
                    activity.background: #1E1E1E
                    activity.surface: #252526
                    activity.toolbar.background: #252526
                    activity.toolbar.foreground: #E8E8E8
                    activity.tabs.background: #252526
                    activity.tabs.foreground: #9DA0A6
                    activity.tabs.selected: #FFFFFF
                    activity.tabs.indicator: #CC7832
                    activity.statusBar: #1E1E1E
                    activity.navigationBar: #1E1E1E
                }
            }
        }

        github {
            light [
                keyword: #0550AE @bold,
                keyword2: #8250DF,
                type: #953800,
                typeBuiltin: #0550AE,
                string: #0A3069,
                stringBlock: #0A3069,
                comment: #6E7781,
                docComment: #6E7781 @no-bold,
                docTag: #8250DF,
                number: #0550AE,
                annotation: #8250DF,
                constant: #0550AE,
                variable: #24292F,
                function: #8250DF,
                operator: #24292F
            ]
            dark [
                keyword: #79C0FF @bold,
                keyword2: #D2A8FF,
                type: #FFA657,
                typeBuiltin: #79C0FF,
                string: #A5D6FF,
                stringBlock: #A5D6FF,
                comment: #8B949E,
                docComment: #8B949E @no-bold,
                docTag: #D2A8FF,
                number: #79C0FF,
                annotation: #D2A8FF,
                constant: #79C0FF,
                variable: #E6EDF3,
                function: #D2A8FF,
                operator: #E6EDF3
            ]
            ui {
                light {
                    editor.background: #FFFFFF
                    editor.foreground: #24292F
                    editor.selection: #B6E3FF
                    editor.lineHighlight: #F6F8FA
                    editor.gutter: #6E7781
                    editor.caret: #24292F
                    activity.background: #FFFFFF
                    activity.surface: #F6F8FA
                    activity.toolbar.background: #F6F8FA
                    activity.toolbar.foreground: #24292F
                    activity.tabs.background: #F6F8FA
                    activity.tabs.foreground: #6E7781
                    activity.tabs.selected: #24292F
                    activity.tabs.indicator: #0969DA
                    activity.statusBar: #F6F8FA
                    activity.navigationBar: #FFFFFF
                }
                dark {
                    editor.background: #0D1117
                    editor.foreground: #E6EDF3
                    editor.selection: #264F78
                    editor.lineHighlight: #161B22
                    editor.gutter: #8B949E
                    editor.caret: #E6EDF3
                    activity.background: #0D1117
                    activity.surface: #161B22
                    activity.toolbar.background: #161B22
                    activity.toolbar.foreground: #E6EDF3
                    activity.tabs.background: #161B22
                    activity.tabs.foreground: #8B949E
                    activity.tabs.selected: #E6EDF3
                    activity.tabs.indicator: #2F81F7
                    activity.statusBar: #0D1117
                    activity.navigationBar: #0D1117
                }
            }
        }
    },

    // =========================================================================
    // 4. Tree-sitter ATS AST selector rules (native syntax-node captures only)
    // =========================================================================
    ast: [
        // --- 4.1 类型声明节点 ---
        { node: "class_declaration", field: "name", style: "type", priority: 110 },
        { node: "interface_declaration", field: "name", style: "type", priority: 110 },
        { node: "record_declaration", field: "name", style: "type", priority: 110 },
        { node: "enum_declaration", field: "name", style: "type", priority: 110 },

        // --- 4.2 方法与构造器声明 ---
        { node: "method_declaration", field: "name", style: "function", priority: 115 },
        { node: "constructor_declaration", field: "name", style: "function", priority: 115 },
        // Variable declarators cover both field and local declaration names.
        { node: "variable_declarator", field: "name", style: "variable", priority: 100 },

        // --- 4.3 枚举常量声明 ---
        { node: "enum_constant", field: "name", style: "constant", priority: 105 },

        // --- 4.4 函数调用与动态属性绑定 (消除 AST 歧义) ---
        { node: "method_invocation", field: "name", style: "function", priority: 105 },
        { node: "field_access", field: "field", style: "variable", priority: 100 },

        // --- 4.5 类型标识符宏观着色 ---
        { node: "type_identifier", style: "type", priority: 95 },
        { node: "scoped_type_identifier", style: "type", priority: 95 },
        { node: "@", named: false, parent: "annotation", style: "annotation", priority: 120 },
        { node: "@", named: false, parent: "marker_annotation", style: "annotation", priority: 120 },
        { node: "annotation", field: "name", style: "annotation", priority: 120 },
        { node: "marker_annotation", field: "name", style: "annotation", priority: 120 },

        // --- 4.6 字符串、字符、数值与注释节点：仅使用语法节点范围捕获 ---
        { node: "string_literal", style: "string", priority: 125 },
        { node: "character_literal", style: "string", priority: 125 },
        { node: "line_comment", style: "comment", priority: 130 },
        { node: "block_comment", style: "comment", priority: 130 },
        { node: "decimal_integer_literal", style: "number", priority: 90 },
        { node: "hex_integer_literal", style: "number", priority: 90 },
        { node: "octal_integer_literal", style: "number", priority: 90 },
        { node: "binary_integer_literal", style: "number", priority: 90 },
        { node: "decimal_floating_point_literal", style: "number", priority: 90 },
        { node: "hex_floating_point_literal", style: "number", priority: 90 },

        // --- 4.7 常量命名约定在 AST 标识符范围内判定 ---

        { node: "annotation_type_declaration", field: "name", style: "type", priority: 110 },
        { node: "formal_parameter", field: "name", style: "variable", priority: 105 },
        { node: "catch_formal_parameter", field: "name", style: "variable", priority: 105 },
        { node: "method_reference", field: "name", style: "function", priority: 105 },
    ],

    // =========================================================================
    // 4.6 Native Tree-sitter SCM query and predicate pipeline
    // =========================================================================
    treeSitter {
        queries: [

            {
                id: "java-annotation-marker"
                priority: 120
                source: `(annotation "@" @annotationMarker)`
                captures: { annotationMarker: annotation }
            },
            {
                id: "java-marker-annotation-marker"
                priority: 120
                source: `(marker_annotation "@" @annotationMarker)`
                captures: { annotationMarker: annotation }
            },
            {
                id: "java-type-declarations"
                priority: 135
                source: `[(class_declaration name: (identifier) @type) (interface_declaration name: (identifier) @type) (enum_declaration name: (identifier) @type) (record_declaration name: (identifier) @type) (annotation_type_declaration name: (identifier) @type)]`
            },
            {
                id: "java-method-declarations"
                priority: 132
                source: `(method_declaration name: (identifier) @function (#kind-eq? @function "identifier"))`
            },
            {
                id: "java-constructor-declarations"
                priority: 132
                source: `(constructor_declaration name: (identifier) @function)`
            },
            {
                id: "java-formal-parameters"
                priority: 128
                source: `(formal_parameter name: (identifier) @variable (#has-parent? @variable "formal_parameter"))`
            },
            {
                id: "java-method-invocations"
                priority: 126
                source: `(method_invocation name: (identifier) @function)`
            },
            {
                id: "java-field-access"
                priority: 124
                source: `(field_access field: (identifier) @variable)`
            },
            {
                id: "java-javadoc-blocks"
                priority: 145
                source: `((block_comment) @docComment (#contains? @docComment "@"))`
            },
            {
                id: "java-line-comments"
                priority: 130
                source: `(line_comment) @comment`
            },
            {
                id: "java-string-literals"
                priority: 140
                source: `(string_literal) @string`
            },
            {
                id: "java-character-literals"
                priority: 140
                source: `(character_literal) @string`
            },
            {
                id: "java-number-literals"
                priority: 120
                source: `[(decimal_integer_literal) (hex_integer_literal) (octal_integer_literal) (binary_integer_literal) (decimal_floating_point_literal) (hex_floating_point_literal)] @number`
            },
            {
                id: "java-keyword-tokens"
                priority: 96
                source: `["public" "protected" "private" "abstract" "static" "final" "native" "synchronized" "volatile" "transient" "strictfp" "class" "interface" "enum" "record" "extends" "implements" "permits" "return" "throw" "throws" "new" "this" "super" "if" "else" "switch" "case" "default" "for" "while" "do" "break" "continue" "try" "catch" "finally" "yield" "assert" "package" "import"] @keyword`
            },
            {
                id: "java-literal-constants"
                priority: 96
                source: `["true" "false" "null"] @constant`
            },
            {
                id: "java-annotation-names"
                priority: 138
                source: `[(annotation name: (identifier) @annotation) (marker_annotation name: (identifier) @annotation)]`
            },
            {
                id: "java-selected-entry-points"
                priority: 127
                source: `(method_declaration name: (identifier) @function (#any-of? @function "main" "run" "execute" "invoke"))`
            },
            {
                id: "java-exclude-object-method-name"
                priority: 125
                source: `(method_declaration name: (identifier) @function (#not-eq? @function "toString"))`
            },
            {
                id: "java-methods-inside-types"
                priority: 123
                source: `(method_declaration name: (identifier) @function (#has-ancestor? @function "class_declaration"))`
            },
            {
                id: "java-non-test-method-names"
                priority: 122
                source: `(method_declaration name: (identifier) @function (#not-contains? @function "test"))`
            },
            {
                id: "java-getter-method-names"
                priority: 121
                source: `(method_declaration name: (identifier) @function (#contains? @function "get"))`
            },
            {
                id: "java-exact-demo-type"
                priority: 136
                source: `(class_declaration name: (identifier) @type (#eq? @type "Demo"))`
            },

            {
                id: "java-primitive-types"
                priority: 98
                source: `["boolean" "byte" "char" "short" "int" "long" "float" "double" "void"] @typeBuiltin`
            },
            {
                id: "java-operator-tokens"
                priority: 66
                source: `["->" "::" "==" "!=" "<=" ">=" "&&" "||" "++" "--" "+=" "-=" "*=" "/=" "%=" "=" "+" "-" "*" "/" "%" "!" "~" "^" "&" "|" "<" ">"] @operator`
            },
            {
                id: "java-punctuation-tokens"
                priority: 56
                source: `["{" "}" "(" ")" "[" "]" "," ";" "." ":" "?"] @operator`
            },
            {
                id: "java-package-and-import-names"
                priority: 92
                source: `[(package_declaration (scoped_identifier) @type) (import_declaration (scoped_identifier) @type)]`
            },
            {
                id: "java-type-parameters"
                priority: 112
                source: `(type_parameter (type_identifier) @type)`
            },

            {
                id: "java-any-equal-name"
                priority: 120
                source: `(method_declaration name: (identifier) @function parameters: (formal_parameters (formal_parameter name: (identifier) @variable)) (#any-eq? @function @variable))`
            },
            {
                id: "java-any-not-equal-name"
                priority: 119
                source: `(method_declaration name: (identifier) @function parameters: (formal_parameters (formal_parameter name: (identifier) @variable)) (#any-not-eq? @function @variable))`
            },
            {
                id: "java-not-any-of-excluded-methods"
                priority: 118
                source: `(method_declaration name: (identifier) @function (#not-any-of? @function "skip"))`
            },
            {
                id: "java-any-contains-getter"
                priority: 117
                source: `(method_declaration name: (identifier) @function (#any-contains? @function "get"))`
            },
            {
                id: "java-any-not-contains-test"
                priority: 116
                source: `(method_declaration name: (identifier) @function (#any-not-contains? @function "test"))`
            },
            {
                id: "java-not-direct-field-parent"
                priority: 115
                source: `(method_declaration name: (identifier) @function (#not-has-parent? @function "field_declaration"))`
            },

            {
                id: "java-generic-identifiers"
                priority: 60
                source: `(identifier) @variable`
            }


        ]
    }
}