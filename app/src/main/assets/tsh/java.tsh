{
    name: ["Java", ".java", ".jav"],
    ignoreCase: false,

    // =========================================================================
    // 1. 词法容器定界与括号配对 (Bracket & Comment Pairing)
    // =========================================================================
    comment: {startsWith: "//"},
    comment: {startsWith: "/*", endsWith: "*/"},
    bracketPairs: ["{}", "[]", "()", "<>"],

    // =========================================================================
    // 2. Semantic style catalog and unlimited named schemes
    // =========================================================================
    isDark: false,
    defaultScheme: "darcula",
    styles {
        keyword       { scope: "keyword.control", tags: ["keyword", "control"] }
        keyword2      { scope: "keyword.context", tags: ["keyword", "contextual"] }
        type          { scope: "entity.name.type", tags: ["type", "declaration"] }
        typeBuiltin   { scope: "support.type", tags: ["type", "builtin"] }
        string        { scope: "string.quoted", tags: ["string"] }
        stringBlock   { scope: "string.quoted.block", tags: ["string", "multiline"] }
        comment       { scope: "comment", tags: ["comment"] }
        docComment    { scope: "comment.block.documentation", tags: ["comment", "documentation"] }
        docTag        { scope: "keyword.other.documentation", tags: ["documentation", "tag"] }
        number        { scope: "constant.numeric", tags: ["constant", "number"] }
        annotation    { scope: "storage.type.annotation", tags: ["annotation", "metadata"] }
        constant      { scope: "constant.language", tags: ["constant"] }
        variable      { scope: "variable.other", tags: ["variable"] }
        function      { scope: "entity.name.function", tags: ["function"] }
        operator      { scope: "keyword.operator", tags: ["operator"] }
    },

    schemes {
        darcula {
            light [
                keyword: #0000FF @bold,
                keyword2: #7F0055,
                type: #2B91AF,
                typeBuiltin: #0000FF,
                string: #A31515,
                stringBlock: #800000,
                comment: #008000,
                docComment: #3F5FBF,
                docTag: #7F0055 @bold,
                number: #098658,
                annotation: #2B91AF,
                constant: #6F42C1 @bold,
                variable: #001080,
                function: #795E26,
                operator: #000000
            ]
            dark [
                keyword: #CC7832 @bold,
                keyword2: #6897BB,
                type: #4EC9B0,
                typeBuiltin: #E06C75,
                string: #6A8759,
                stringBlock: #497B51,
                comment: #808080,
                docComment: #629755,
                docTag: #526F5C @bold,
                number: #6897BB,
                annotation: #BBB529,
                constant: #9876AA @bold,
                variable: #A9B7C6,
                function: #FFC66D,
                operator: #A9B7C6
            ]
            ui {
                editor.background: #FFFFFF
                editor.foreground: #202020
                editor.selection: #ADD6FF
                editor.lineHighlight: #F2F2F2
                editor.gutter: #858585
                editor.caret: #000000
            }
        }

        github {
            light [
                keyword: #0550AE @bold,
                keyword2: #8250DF,
                type: #953800,
                typeBuiltin: #0550AE,
                string: #0A3069,
                stringBlock: #0A3069,
                comment: #6E7781,
                docComment: #6E7781,
                docTag: #8250DF,
                number: #0550AE,
                annotation: #8250DF,
                constant: #0550AE,
                variable: #24292F,
                function: #8250DF,
                operator: #24292F
            ]
            dark [
                keyword: #79C0FF @bold,
                keyword2: #D2A8FF,
                type: #FFA657,
                typeBuiltin: #79C0FF,
                string: #A5D6FF,
                stringBlock: #A5D6FF,
                comment: #8B949E,
                docComment: #8B949E,
                docTag: #D2A8FF,
                number: #79C0FF,
                annotation: #D2A8FF,
                constant: #79C0FF,
                variable: #E6EDF3,
                function: #D2A8FF,
                operator: #E6EDF3
            ]
            ui {
                editor.background: #FFFFFF
                editor.foreground: #24292F
                editor.selection: #B6E3FF
                editor.lineHighlight: #F6F8FA
                editor.gutter: #6E7781
                editor.caret: #24292F
            }
        }
    },

    // =========================================================================
    // 3. 复用宏词典 (Defines: 词法片段)
    // =========================================================================
    defines: [
        "identifier": /[a-zA-Z_$][a-zA-Z0-9_$]*/,
        "docTags": /@(param|return|throws|exception|see|since|deprecated|author|version|serial)\b/,
                "javaQuotedString": /"(?:\\.|[^"\\])*"|'(?:\\.|[^'\\])*'/,
                "javaNumber": /\b(?:0[xX][0-9a-fA-F_]+|0[bB][01_]+|0[0-7_]+|[0-9_]+(?:\.[0-9_]+)?(?:[eE][+-]?[0-9_]+)?[fFdDlL]?)\b/
    ],

    // =========================================================================
    // 4. 原生 AST 节点选择器规则 (Native AST Selectors: 100% 解耦 SCM，内核寄存器直连)
    // =========================================================================
    ast: [
        // --- 4.1 符号大纲、代码折叠与类结构声明 ---
        { node: "class_declaration", field: "name", style: "type" },
        { node: "interface_declaration", field: "name", style: "type" },
        { node: "record_declaration", field: "name", style: "type" },
        { node: "enum_declaration", field: "name", style: "type" },

        // --- 4.2 方法与构造器声明 (绑定大纲与折叠) ---
        { node: "method_declaration", field: "name", style: "function" },
        { node: "constructor_declaration", field: "name", style: "function" },

        // --- 4.3 字段、常量与枚举项声明 ---
        { node: "enum_constant", field: "name", style: "constant" },

        // --- 4.4 函数调用与动态属性绑定 (消除 AST 歧义) ---
        { node: "method_invocation", field: "name", style: "function" },
        { node: "field_access", field: "field", style: "variable" },

        // --- 4.5 类型标识符宏观着色 ---
        { node: "type_identifier", style: "type" },
        { node: "scoped_type_identifier", style: "type" },
        { node: "annotation", field: "name", style: "annotation" },
        { node: "marker_annotation", field: "name", style: "annotation" }
    ],

    // =========================================================================
    // 5. 微观正则流与下推自动机 Block 匹配流 (Contains)
    // =========================================================================
    contains: [
        // ---------- 5.1 文本块 Text Block (Java 15+，最高优先级) ----------
        {
            style: "stringBlock",
            start: {match: /"""/},
            end: {match: /"""/},
            contains: [
                {match: /\\[sntbrf\\"']/, 0: "operator"}
            ]
        },

        // ---------- 5.2 Javadoc 结构注释块 ----------
        {
            style: "docComment",
            start: {match: /\/\*\*/},
            end: {match: /\*\//},
            contains: [
                {match: include("docTags"), 0: "docTag"},
                {match: /\{@\w+[^}]*\}/, 0: "annotation"}
            ]
        },

        // ---------- 5.3 字符串与数值复合内置模式 ----------
        {builtin: "javaQuotedString"},
        {builtin: "javaNumber"},

        // ---------- 5.4 单行与普通多行注释 ----------
        {
            match: /\/\/.*/,
            0: "comment",
            contains: [
                {match: /\b(TODO|FIXME|XXX|BUG|NOTE)\b/, 0: "constant"}
            ]
        },
        {
            style: "comment",
            start: {match: /\/\*/},
            end: {match: /\*\//},
            contains: [
                {match: /\b(TODO|FIXME|XXX|BUG|NOTE)\b/, 0: "constant"}
            ]
        },

        // ---------- 5.5 元数据注解 (Annotations) ----------
        {match: /@\w+(?:\.\w+)*/, 0: "annotation"},

        // ---------- 5.6 静态常量规范 (SCREAMING_SNAKE_CASE) ----------
        {match: /\b[A-Z][A-Z0-9]*(?:_[A-Z0-9]+)+\b(?!\s*\()/, 0: "constant"},
        {match: /\b(?!(?:URL|URI|XML|JSON|HTTP|UUID|ID|EOF)\b)[A-Z][A-Z0-9]{2,}\b(?!\.)(?!\s*\()/, 0: "constant"},

        // ---------- 5.7 基础原始数据类型 (Primitive Types) ----------
        {match: keywordsToRegex("boolean byte char short int long float double void"), 0: "typeBuiltin"},

        // ---------- 5.8 核心控制流与结构关键字 ----------
        {match: keywordsToRegex(
            "if else switch case default for while do break continue return yield "
            "try catch finally throw throws "
            "class interface enum record extends implements permits "
            "public protected private abstract static final strictfp "
            "synchronized volatile transient "
            "new this super instanceof "
            "package import module open opens requires exports provides uses with to "
            "native assert"
        ), 0: "keyword"},

        // ---------- 5.9 上下文与现代演进关键字 (Java 10/14/17/21+) ----------
        {match: keywordsToRegex("var non-sealed sealed record when"), 0: "keyword2"},

        // ---------- 5.10 字面量常量 ----------
        {match: keywordsToRegex("true false null"), 0: "constant"},

        // ---------- 5.11 方法调用微观补充 ----------
        {match: /\b[A-Za-z_$][A-Za-z0-9_$]*(?=\s*\()/, 0: "function"},

        // ---------- 5.12 常用核心类自动高亮 ----------
        {match: keywordsToRegex(
            "String Object Class System Math Thread Runnable AutoCloseable "
            "Integer Long Short Byte Double Float Character Boolean Void "
            "List Map Set Queue Deque Collection ArrayList HashMap HashSet LinkedList "
            "Optional CompletableFuture Stream Arrays Collections Objects "
            "Exception RuntimeException Throwable Error IOException"
        ), 0: "type"},

        // 驼峰命名类名
        {match: /\b[A-Z]\w*\b/, 0: "type"},

        // ---------- 5.13 操作符、方法引用与标点符号 ----------
        {match: /::/, 0: "operator"},
        {match: /->/, 0: "operator"},
        {match: /[?:]/, 0: "operator"},
        {match: /[=+\-*\/%&|^!~<>]/, 0: "operator"},
        {match: /[{}()\[\],;.]/, 0: "operator"}
    ]
}